<?xml version="1.0" encoding="UTF-8" ?>

<section xml:id="sec-techniques-limits">
    <title>Techniques for Finding Limits</title>

    <theorem xml:id="thm-limit-principles">
 <title>Limit Principles</title>
 <statement>
     <p>
  If <m>\displaystyle \lim_{x \to a}f(x)=L</m> and <m>\displaystyle \lim_{x \to a}g(x)=M</m>, then:
  <ol marker="1">
      <li><p><m>\displaystyle \lim_{x \to a}c=c</m></p></li>
      <li><p><m>\displaystyle \lim_{x \to a}[f(x)]^n = L^n</m></p></li>
      <li><p><m>\displaystyle \lim_{x \to a}\sqrt[n]{f(x)} = \sqrt[n]{L}</m></p></li>
      <li><p><term>Sum/Difference:</term> <m>\displaystyle \lim_{x \to a}[f(x)\pm g(x)] = L \pm M</m></p></li>
      <li><p><term>Product:</term> <m>\displaystyle \lim_{x \to a}[f(x)\cdot g(x)] = L \cdot M</m></p></li>
      <li><p><term>Quotient:</term> <m>\displaystyle \lim_{x \to a}\frac{g(x)}{f(x)} = \frac{M}{L}</m>, if <m>L \neq 0</m></p></li>
      <li><p><m>\displaystyle \lim_{x \to a}cf(x) = c \cdot L</m></p></li>
      <li><p>If <m>f</m> is a polynomial, <m>\displaystyle \lim_{x \to a}f(x)=f(a)</m></p></li>
      <li><p>If <m>r</m> is a rational function, <m>\displaystyle \lim_{x \to a}r(x)=r(a)</m> (where defined)</p></li>
  </ol>
     </p>
 </statement>
    </theorem>

    <exercise xml:id="exe-substitution">
 <title>Limit by Direct Substitution</title>
 <statement>
     <p>Find <m>\displaystyle\lim_{x\to 2}\frac{x^3+1}{2x}</m>.</p>
 </statement>
 <solution>
     <p>
  By direct substitution:
  <me>\lim_{x\to 2}\frac{x^3+1}{2x} = \frac{2^3+1}{2(2)} = \frac{9}{4}</me>.
     </p>
 </solution>
    </exercise>

    <exercise xml:id="exe-factoring-negative">
 <title>Limit by Factoring</title>
 <statement>
     <p>Find <m>\displaystyle\lim_{x\to -3}\frac{x+3}{x^2-9}</m>.</p>
 </statement>
 <solution>
     <p>
  Substituting <m>-3</m> gives <m>0/0</m>. We factor the denominator:
  <me>\lim_{x\to -3}\frac{x+3}{(x+3)(x-3)} = \lim_{x\to -3}\frac{1}{x-3} = \frac{1}{-3-3} = -\frac{1}{6}</me>.
     </p>
 </solution>
    </exercise>

    <example xml:id="ex-conjugate-simple">
 <title>Limit involving Square Roots</title>
 <statement>
     <p>If <m>f(x)= \frac{x-9}{\sqrt{x}-3}</m>, find <m>\displaystyle\lim_{x \to 9} f(x)</m>.</p>
 </statement>
 <solution>
     <p>
  Factoring the numerator as a difference of squares:
  <me>\lim_{x \to 9} \frac{(\sqrt{x}-3)(\sqrt{x}+3)}{\sqrt{x}-3} = \lim_{x \to 9} (\sqrt{x}+3) = \sqrt{9}+3 = 6</me>.
     </p>
 </solution>
    </example>

    <example xml:id="ex-various-techniques">
 <title>Mixed Limit Practice</title>
 <statement>
     <p>
  Find the following limits:
  <ol marker="a">
      <li><p><m>\displaystyle \lim_{x \to 2}(x^4-5x^3+x^2-7)</m></p></li>
      <li><p><m>\displaystyle \lim_{x \to 0}\sqrt{x^2-3x+2}</m></p></li>
      <li><p><m>\displaystyle \lim_{x \to -3}\frac{x^2-9}{x+3}</m></p></li>
  </ol>
     </p>
 </statement>
 <solution>
     <p>
  <ol marker="a">
      <li><p><m>2^4 - 5(2^3) + 2^2 - 7 = 16 - 40 + 4 - 7 = -27</m></p></li>
      <li><p><m>\sqrt{0^2 - 3(0) + 2} = \sqrt{2}</m></p></li>
      <li><p><m>\lim_{x \to -3} \frac{(x-3)(x+3)}{x+3} = \lim_{x \to -3} (x-3) = -6</m></p></li>
  </ol>
     </p>
 </solution>
    </example>

    <example xml:id="ex-piecewise">
 <title>Limit of a Piecewise Function</title>
 <statement>
     <p>
  Find <m>\displaystyle\lim_{x\to 1} g(x)</m> where 
  <me>g(x)=\begin{cases} x+1 \amp \text{if } x \neq 1 \\ \pi \amp \text{if } x=1 \end{cases}</me>
     </p>
 </statement>
 <solution>
     <p>
  The limit depends only on values near 1, not at <m>x=1</m>.
  As <m>x \to 1</m>, <m>g(x) = x+1</m>. Thus, the limit is <m>1+1=2</m>.
     </p>
 </solution>
    </example>

    <theorem xml:id="thm-sandwich">
 <title>Sandwich Theorem (Squeeze Theorem)</title>
 <statement>
     <p>
  Suppose <m>f(x) \leq h(x) \leq g(x)</m> near <m>a</m> (except possibly at <m>a</m>).
  If <m>\displaystyle \lim_{x \to a}f(x)=L=\lim_{x \to a}g(x)</m>, then <m>\displaystyle \lim_{x \to a}h(x)=L</m>.
     </p>
 </statement>
    </theorem>

    <exercise xml:id="exe-sandwich-sine">
 <title>Proving a Limit with Sandwich Theorem</title>
 <statement>
     <p>Prove <m>\displaystyle \lim_{x \to 0}x^2\sin\left(\frac{1}{x^2}\right)=0</m>.</p>
 </statement>
 <solution>
     <p>
  Since <m>-1 \leq \sin(\theta) \leq 1</m>, we have:
  <me>-1 \leq \sin\left(\frac{1}{x^2}\right) \leq 1</me>
  Multiply by <m>x^2</m> (which is always <m>\geq 0</m>):
  <me>-x^2 \leq x^2\sin\left(\frac{1}{x^2}\right) \leq x^2</me>
  Since <m>\lim_{x \to 0}(-x^2) = 0</m> and <m>\lim_{x \to 0}(x^2) = 0</m>, by the Sandwich Theorem, the limit is 0.
     </p>
 </solution>
    </exercise>
</section>
